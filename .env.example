# Copy to `.env` locally. For Cloudflare Pages, add each variable in the dashboard
# (Settings → Environment variables) — do not commit real secrets.

# Neon connection string from the Neon dashboard (Connection details → URI).
# MUST be a single line with no line breaks. If your password has @ or other special
# characters, use Neon’s “reset password” or URL-encode those characters.
# Tip: Some hosts drop very long lines when you paste an entire .env at once — add
# DATABASE_URL separately if bulk paste fails.
DATABASE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

OPENAI_API_KEY=
